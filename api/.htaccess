Options -Indexes
<FilesMatch "^(podcast|push|emergency-poll|emergency-dispatch)\.php$">
  Require all granted
</FilesMatch>
<FilesMatch "^(?!(podcast|push|emergency-poll|emergency-dispatch)\.php$).+">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set Cache-Control "no-store, private"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
